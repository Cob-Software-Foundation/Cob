# Keeps the build context small. The product Dockerfile builds the interpreter,
# compiler, farmer and the standard library without raylib or raygui (barn is
# not in the image), so those vendored sources are not sent to the daemon. Dockerfile.stress has its own list
# (Dockerfile.stress.dockerignore) because it DOES build barn.
.git
.github
bin
docs
**/*.strawberry
**/*.o
vendor/raylib
vendor/raygui
target
