bin/*

# WebAssembly playground build output (generated by `make play`; CI builds it fresh)
docs/play/cob_interp.js
docs/play/cob_interp.wasm
docs/play/version.txt

# tools/ffi/: the example native extension, its caches, and anything a
# local `cob_interp`/`popcorn_comp` run against it produces -- never the
# checked-in math_ext.c/ffi_test.cob/ffi_test.expected themselves.
tools/ffi/*.strawberry
tools/ffi/*.so
tools/ffi/*.dylib
tools/ffi/*.dll
tools/ffi/*.popcorn_tmp.c
tools/ffi/ffi_test_native*

# Enterprise licensing: NEVER commit the private signing key or issued licenses.
# (include/drm_pubkey.h is the PUBLIC key and is safe to commit.)
*.key
cob_private*
*.lic
