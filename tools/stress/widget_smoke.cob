_MakeCache = False
shuck barn
set w = barn_open("Widget Smoke Test")
set rc = barn_label(w, "Hello from Cob widgets!")
set clicked = barn_button(w, "Click me")
set val = barn_slider(w, "Volume", 100)
set txt = barn_textbox(w, "Name")
pop("clicked (should be 0, nothing clicked yet): " + clicked)
pop("slider value (should be 0): " + val)
pop("textbox contents (should be empty): " + txt)
set rc = barn_wait(w, 2)
set clicked2 = barn_button(w, "Click me")
pop("clicked2 after 2s idle wait (should still be 0): " + clicked2)
set rc = barn_close(w)
pop("done")
