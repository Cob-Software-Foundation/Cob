ROOT_DIR		= ./..
TOP_DIR			= $(shell cd ./..; pwd -W 2>/dev/null || pwd -P)
WIN_DIR			= $(TOP_DIR)/win
UNIX_DIR		= $(TOP_DIR)/unix
GENERIC_DIR		= $(TOP_DIR)/generic
TTK_DIR			= $(GENERIC_DIR)/ttk
BITMAP_DIR		= $(TOP_DIR)/bitmaps
XLIB_DIR		= $(TOP_DIR)/xlib
